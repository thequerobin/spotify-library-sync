SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DATABASE=./data/spotify_library.db
SPOTIFY_REQUEST_INTERVAL_MS=500
SPOTIFY_METADATA_TTL_DAYS=30

